// Slide "Low Barrier to Adoption"
// The generated thermostat reactor has no main reactor. This file adds one.
target Python {
    fast: true,
    timeout: 20 sec
}

import ThermostatBehavior from "../out/ThermostatBehavior.lf"   // generated by sysmlc

main reactor {
    thermostat = new ThermostatBehavior()
    state last = ""

    reaction(thermostat.current_state) {=   # arrives every second, print only the changes
        mode = thermostat.current_state.value
        if mode != self.last:
            print(f"[{lf.time.logical_elapsed() / 1e9:5.2f} s] thermostat: {mode}")
            self.last = mode
    =}
}
