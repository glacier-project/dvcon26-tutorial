// The generated Furuta program with one extra reactor, a Visualizer.
// It reads the same AngleReading stream as the controller.
// The wiring matches the generated main reactor, minus the Monitor.
// The Monitor stops the run as soon as the pendulum is caught.
// The Visualizer keeps going for `hold` more seconds instead,
// so you can see the pendulum stay balanced.
target Python {
    fast: true,
    timeout: 30 sec,
    files: ["furuta_viz.py"]
}

import PendulumSim, Controller from "../out/furutaSystem.lf"   // generated by sysmlc

preamble {=
    import furuta_viz   # the gauge and the plots
    import logging
    logging.getLogger("sysmlc").setLevel(logging.INFO)   # hide the state trace, it has too many lines
    def now():
        return f"[{lf.time.logical_elapsed() / 1e9:5.2f} s]"
=}

reactor Visualizer(every = 20, hold = 2 sec) {   // one line every 20 readings, or 100 ms
    input reading      // the pendulum's angles, as the controller sees them
    input phase        // the controller's current state
    input balanced     // the testbench verdict
    logical action stop
    state samples = []
    state phases = []
    state current = "?"
    state stopping = False

    reaction(phase) {=
        if phase.value.startswith("send") or phase.value == self.current:
            return                         # skip the short "send…" states and repeats
        self.current = phase.value
        self.phases.append((lf.time.logical_elapsed() / 1e9, self.current))
        print(f"{now()} controller -> {self.current}")
    =}

    reaction(reading) {=
        r = reading.value
        self.samples.append((lf.time.logical_elapsed() / 1e9, r.theta, r.phi, self.current))
        if len(self.samples) % self.every == 0:
            print(f"{now()} {furuta_viz.gauge(r.theta)}  {self.current}")
    =}

    reaction(balanced) -> stop {=
        if not self.stopping:
            print(f"{now()} Balanced! (the testbench verdict) - watching {self.hold / 1e9:.0f} s more")
            self.stopping = True
            stop.schedule(self.hold)
    =}

    reaction(stop) {=
        lf.request_stop()
    =}

    reaction(shutdown) {=
        print(furuta_viz.save(self.samples, self.phases))
    =}
}

main reactor {
    sim = new PendulumSim()
    ctrl = new Controller()
    viz = new Visualizer()

    sim.AngleReading -> ctrl.AngleReading
    ctrl.Control -> sim.Control

    sim.AngleReading -> viz.reading
    ctrl.current_state -> viz.phase
    ctrl.Balanced -> viz.balanced
}
